  .risk-item p { font-size:var(--text-sm); color:var(--color-muted); line-height:1.75; margin:0; }

  .blog-tip { background:var(--color-deep); border-radius:var(--radius-sm); padding: var(--space-6) var(--space-8); margin: var(--space-8) 0; }
  .blog-tip__label { font-size:var(--text-xs); font-weight:700; letter-spacing:.15em; text-transform:uppercase; color:var(--color-aqua); margin-bottom: var(--space-2); font-family:var(--font-heading); }
