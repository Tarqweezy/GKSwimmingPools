---
import Layout from '../layouts/Layout.astro';

const WEB3FORMS_KEY = "YOUR_WEB3FORMS_KEY";
---

<Layout
  title="Free Pool Remodel Estimate | GK Swimming Pools"
  description="Get a free pool remodeling estimate in 60 seconds. Replastering, Pebble Tec, and full remodels. Serving Santa Clarita and the San Fernando Valley. Financing available."
>
<!-- HERO -->
<section class="hero">
  <div class="hero__bg">
    <img src="/images/remodeling/pool-mosaic-tile-remodel-santa-clarita.webp" alt="Custom mosaic pool tile remodel in Santa Clarita" fetchpriority="high" decoding="async" width="1400" height="933" />
  </div>
  <div class="hero__overlay"></div>
  <div class="hero__content">
  <div class="hero-eyebrow">Free Estimate. No Obligation</div>
  <h1>Give Your Pool the <span>Remodel</span> It Deserves</h1>
  <p>Replastering, Pebble Tec, and full pool remodels. Serving Santa Clarita and the San Fernando Valley. Financing available.</p>
  <a href="#get-quote" class="hero-cta">Get My Free Estimate &darr;</a>
  </div>
</section>

<!-- TRUST BAR -->
<div class="trust-bar">
  <div class="trust-item">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    <span>Licensed &amp; Insured</span>
  </div>
  <div class="trust-item">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    <span>Free On-Site Estimate</span>
  </div>
  <div class="trust-item">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
    <span>Financing Available</span>
  </div>
  <div class="trust-item">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
    <span>5.0 Google Rating</span>
  </div>
</div>

<!-- SERVICES -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">What We Do</span>
      <h2>Pool Remodeling Services</h2>
      <p>From a fresh plaster coat to a complete transformation. we handle every level of pool remodel.</p>
    </div>
    <div class="services-grid">
      <div class="service-card">
        <div class="service-card__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
        </div>
        <h3>Pool Replastering</h3>
        <p>Restore your pool's surface to like-new condition. Smooth out rough spots, eliminate staining, and stop slow leaks caused by aging plaster.</p>
        <span class="price-range">Starting at $4,500</span>
      </div>
      <div class="service-card">
        <div class="service-card__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <h3>Pebble Tec &amp; Premium Finishes</h3>
        <p>Upgrade to a premium pebble or quartz finish that lasts 20+ years and gives your pool a resort-quality look. Multiple colors and textures available.</p>
        <span class="price-range">Starting at $8,000</span>
      </div>
      <div class="service-card">
        <div class="service-card__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        </div>
        <h3>Pool Retiling</h3>
        <p>Refresh your pool's waterline tile or resurface the full interior. Fix cracked and stained tile and give your pool a clean, updated look.</p>
        <span class="price-range">Starting at $2,500</span>
      </div>
      <div class="service-card">
        <div class="service-card__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <h3>Full Pool Remodel</h3>
        <p>Complete transformation. new surface, updated coping, tile work, and equipment upgrades. Turn an outdated pool into the backyard centerpiece it should be.</p>
        <span class="price-range">Starting at $15,000</span>
      </div>
    </div>
  </div>
</section>

<!-- MULTI-STEP FORM -->
<section class="form-section" id="get-quote">
  <div class="form-wrap">
    <div class="form-header">
      <span class="eyebrow">Takes 60 Seconds</span>
      <h2>Get Your Free Estimate</h2>
      <p>Answer 4 quick questions and we'll be in touch within 24 hours with your quote.</p>
    </div>

    <!-- Progress -->
    <div class="form-progress" id="formProgress">
      <div class="progress-step active" id="ps1">1</div>
      <div class="progress-line" id="pl1"></div>
      <div class="progress-step" id="ps2">2</div>
      <div class="progress-line" id="pl2"></div>
      <div class="progress-step" id="ps3">3</div>
      <div class="progress-line" id="pl3"></div>
      <div class="progress-step" id="ps4">4</div>
    </div>

    <div class="form-card">
      <!-- STEP 1 -->
      <div class="form-step active" id="step1">
        <div class="step-label">Step 1 of 4</div>
        <div class="step-question">What type of service are you looking for?</div>
        <div class="option-grid option-grid--4">
          <button class="option-btn" data-step="1" data-value="Pool Replastering" onclick="selectOption(this, 1)">
            <div class="option-btn__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg></div>
            <div class="option-btn__text">
              <strong>Pool Replastering</strong>
              <span>Restore existing plaster surface</span>
            </div>
          </button>
          <button class="option-btn" data-step="1" data-value="Pebble Tec / Premium Finish" onclick="selectOption(this, 1)">
            <div class="option-btn__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div>
            <div class="option-btn__text">
              <strong>Pebble Tec / Premium Finish</strong>
              <span>Upgrade to long-lasting pebble or quartz</span>
            </div>
          </button>
          <button class="option-btn" data-step="1" data-value="Pool Retiling" onclick="selectOption(this, 1)">
            <div class="option-btn__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg></div>
            <div class="option-btn__text">
              <strong>Pool Retiling</strong>
              <span>Waterline or full interior tile</span>
            </div>
          </button>
          <button class="option-btn" data-step="1" data-value="Full Pool Remodel" onclick="selectOption(this, 1)">
            <div class="option-btn__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
            <div class="option-btn__text">
              <strong>Full Pool Remodel</strong>
              <span>Complete transformation</span>
            </div>
          </button>
        </div>
        <div class="form-nav" style="justify-content: flex-end">
          <button class="btn-next" onclick="nextStep(1)">Next &rarr;</button>
        </div>
      </div>

      <!-- STEP 2 -->
      <div class="form-step" id="step2">
        <div class="step-label">Step 2 of 4</div>
        <div class="step-question">How big is your pool?</div>
        <div class="option-grid option-grid--4">
          <button class="option-btn" data-step="2" data-value="Small (under 400 sq ft)" onclick="selectOption(this, 2)">
            <div class="option-btn__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/></svg></div>
            <div class="option-btn__text">
              <strong>Small</strong>
              <span>Under 400 sq ft</span>
            </div>
          </button>
          <button class="option-btn" data-step="2" data-value="Medium (400–600 sq ft)" onclick="selectOption(this, 2)">
            <div class="option-btn__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="7"/></svg></div>
            <div class="option-btn__text">
              <strong>Medium</strong>
              <span>400 – 600 sq ft</span>
            </div>
          </button>
          <button class="option-btn" data-step="2" data-value="Large (600+ sq ft)" onclick="selectOption(this, 2)">
            <div class="option-btn__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s2-4 5-4 5 4 5 4 2-4 5-4 5 4 5 4"/><path d="M2 18s2-4 5-4 5 4 5 4 2-4 5-4 5 4 5 4"/></svg></div>
            <div class="option-btn__text">
              <strong>Large</strong>
              <span>600+ sq ft</span>
            </div>
          </button>
          <button class="option-btn" data-step="2" data-value="Not Sure" onclick="selectOption(this, 2)">
            <div class="option-btn__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
            <div class="option-btn__text">
              <strong>Not Sure</strong>
              <span>We'll measure on-site</span>
            </div>
          </button>
        </div>
        <div class="form-nav">
          <button class="btn-back" onclick="prevStep(2)">&larr; Back</button>
          <button class="btn-next" onclick="nextStep(2)">Next &rarr;</button>
        </div>
      </div>

      <!-- STEP 3 -->
      <div class="form-step" id="step3">
        <div class="step-label">Step 3 of 4</div>
        <div class="step-question">Where is your pool located?</div>
        <div class="form-field">
          <label for="address">Property Address</label>
          <input type="text" id="address" placeholder="123 Main St, Santa Clarita, CA" autocomplete="street-address" />
        </div>
        <div class="form-nav">
          <button class="btn-back" onclick="prevStep(3)">&larr; Back</button>
          <button class="btn-next" onclick="nextStep(3)">Next &rarr;</button>
        </div>
      </div>

      <!-- STEP 4 -->
      <div class="form-step" id="step4">
        <div class="step-label">Step 4 of 4</div>
        <div class="step-question">Almost done. how can we reach you?</div>
        <div class="form-field">
          <label for="name">Your Name</label>
          <input type="text" id="name" placeholder="John Smith" autocomplete="name" />
        </div>
        <div class="form-field">
          <label for="phone">Phone Number</label>
          <input type="tel" id="phone" placeholder="(818) 555-0100" autocomplete="tel" />
        </div>
        <div class="form-nav">
          <button class="btn-back" onclick="prevStep(4)">&larr; Back</button>
          <button class="btn-submit" onclick="submitForm()">Get My Free Estimate ✓</button>
        </div>
      </div>

      <!-- SUCCESS -->
      <div class="form-success" id="formSuccess">
        <div class="success-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <h3>You're All Set!</h3>
        <p>We received your request and will call you within 24 hours to schedule your free on-site assessment.</p>
        <div class="estimate-range">
          <div class="range-label">Your Estimated Range</div>
          <div class="range-value" id="estimateValue">$4,500 – $40,000</div>
          <div class="range-note">Final quote provided after free on-site visit. No obligation.</div>
        </div>
        <p>Questions in the meantime? Call us directly.</p>
        <a href="tel:8188048204" class="btn-aqua">(818) 804-8204</a>
      </div>
    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="section section--mist">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">What to Expect</span>
      <h2>Our Simple 4-Step Process</h2>
      <p>No surprises. Here's exactly what happens after you submit your estimate request.</p>
    </div>
    <div class="process-grid">
      <div class="process-step">
        <div class="process-step__num">1</div>
        <h3>Submit Your Request</h3>
        <p>Fill out the form above in 60 seconds. Tell us your service type, pool size, and contact info.</p>
      </div>
      <div class="process-step">
        <div class="process-step__num">2</div>
        <h3>We Call Within 24 Hours</h3>
        <p>A GK specialist calls you to answer questions and schedule your free on-site visit at a time that works for you.</p>
      </div>
      <div class="process-step">
        <div class="process-step__num">3</div>
        <h3>Free On-Site Assessment</h3>
        <p>We visit your property, assess your pool, and give you a detailed written quote. No obligation, no pressure.</p>
      </div>
      <div class="process-step">
        <div class="process-step__num">4</div>
        <h3>Your Pool Gets Transformed</h3>
        <p>Once you approve the plan, we get to work. Most remodels are completed within 5 to 14 days depending on scope.</p>
      </div>
    </div>
  </div>
</section>

<!-- REVIEWS -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Social Proof</span>
      <h2>What Homeowners Say</h2>
    </div>
    <div class="reviews-row">
      <div class="review-badge">
        <div class="review-badge__stars">★★★★★</div>
        <div class="review-badge__score">5.0</div>
        <div class="review-badge__label">Google Rating</div>
      </div>
      <div style="max-width:480px; color: var(--muted); font-size: 0.95rem; line-height: 1.75; font-style: italic;">
        "GK Swimming Pools did an incredible job on our replaster. The process was smooth, the team was professional, and our pool looks brand new. Highly recommend to anyone in the Santa Clarita area."
        <div style="margin-top: 0.75rem; font-style: normal; font-weight: 700; color: var(--blue); font-size: 0.82rem;">— Verified Google Review</div>
      </div>
    </div>
  </div>
</section>

<!-- FINANCING -->
<section class="section section--mist">
  <div class="container">
    <div class="financing-block">
      <h3>Don't Let Budget Hold You Back</h3>
      <p>We work with a trusted third-party lender to offer flexible financing options so you can get the pool you want without waiting. Ask us about financing when we call.</p>
      <a href="#get-quote" class="btn-aqua">Get My Free Estimate</a>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="site-footer">
  <div class="site-footer__top">
    <div class="container site-footer__grid">
      <div class="site-footer__brand">
        <img src="/images/logo-white.png" alt="GK Swimming Pools" height="48" style="margin-bottom:1rem;" />
        <p>Three generations of honest pool service across Los Angeles. Fair pricing, proactive care, and a commitment to treating every pool like our own.</p>
        <a href="tel:8188048204" class="site-footer__phone">(818) 804-8204</a>
      </div>
      <div class="site-footer__col">
        <div class="site-footer__col-title">Services</div>
        <ul>
          <li><a href="/services/pool-maintenance">Pool Maintenance</a></li>
          <li><a href="/services/pool-inspections">Pool Inspections</a></li>
          <li><a href="/services/pool-repairs">Pool Repairs</a></li>
          <li><a href="/services/pool-remodeling">Pool Remodeling</a></li>
          <li><a href="/services/jacuzzi-service">Jacuzzi Service</a></li>
          <li><a href="/services/commercial-pool-services">Commercial Pool Service</a></li>
        </ul>
      </div>
      <div class="site-footer__col">
        <div class="site-footer__col-title">Company</div>
        <ul>
          <li><a href="/our-story">Our Story</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/blog">Blog</a></li>
        </ul>
      </div>
      <div class="site-footer__col">
        <div class="site-footer__col-title">Service Areas</div>
        <ul>
          <li><a href="/locations/pool-service-santa-clarita">Santa Clarita</a></li>
          <li><a href="/locations/pool-service-valencia">Valencia</a></li>
          <li><a href="/locations/pool-service-granada-hills">Granada Hills</a></li>
          <li><a href="/locations/pool-service-northridge">Northridge</a></li>
          <li><a href="/locations/pool-service-encino">Encino</a></li>
          <li><a href="/locations/pool-service-woodland-hills">Woodland Hills</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="site-footer__bottom">
    <div class="container">
      &copy; 2026 GK Swimming Pools. All rights reserved. | Santa Clarita, CA | (818) 804-8204
    </div>
  </div>
</footer>

<script is:inline>
  // Form state
  const formData = {
    service: "",
    poolSize: "",
    address: "",
    name: "",
    phone: ""
  };

  // Estimate ranges by service + size
  const estimates = {
    "Pool Replastering": { "Small (under 400 sq ft)": "$4,500 – $7,000", "Medium (400–600 sq ft)": "$6,000 – $9,000", "Large (600+ sq ft)": "$9,000 – $14,000", "Not Sure": "$4,500 – $14,000" },
    "Pebble Tec / Premium Finish": { "Small (under 400 sq ft)": "$8,000 – $11,000", "Medium (400–600 sq ft)": "$10,000 – $14,000", "Large (600+ sq ft)": "$13,000 – $18,000", "Not Sure": "$8,000 – $18,000" },
    "Pool Retiling": { "Small (under 400 sq ft)": "$2,500 – $4,500", "Medium (400–600 sq ft)": "$4,000 – $7,000", "Large (600+ sq ft)": "$6,000 – $10,000", "Not Sure": "$2,500 – $10,000" },
    "Full Pool Remodel": { "Small (under 400 sq ft)": "$15,000 – $22,000", "Medium (400–600 sq ft)": "$20,000 – $30,000", "Large (600+ sq ft)": "$28,000 – $40,000", "Not Sure": "$15,000 – $40,000" }
  };

  function selectOption(btn, step) {
    // Deselect siblings
    btn.closest(".option-grid").querySelectorAll(".option-btn").forEach(b => b.classList.remove("selected"));
    btn.classList.add("selected");
    // Store value
    if (step === 1) formData.service = btn.dataset.value;
    if (step === 2) formData.poolSize = btn.dataset.value;
  }

  function updateProgress(currentStep) {
    for (let i = 1; i <= 4; i++) {
      const dot = document.getElementById("ps" + i);
      if (i < currentStep) { dot.className = "progress-step done"; dot.innerHTML = "✓"; }
      else if (i === currentStep) { dot.className = "progress-step active"; dot.innerHTML = i; }
      else { dot.className = "progress-step"; dot.innerHTML = i; }
      if (i < 4) {
        const line = document.getElementById("pl" + i);
        line.className = i < currentStep ? "progress-line done" : "progress-line";
      }
    }
  }

  function nextStep(current) {
    // Validate
    if (current === 1 && !formData.service) { alert("Please select a service type."); return; }
    if (current === 2 && !formData.poolSize) { alert("Please select a pool size."); return; }
    if (current === 3 && !document.getElementById("address").value.trim()) { alert("Please enter your address."); return; }

    if (current === 3) formData.address = document.getElementById("address").value.trim();

    document.getElementById("step" + current).classList.remove("active");
    document.getElementById("step" + (current + 1)).classList.add("active");
    updateProgress(current + 1);
  }

  function prevStep(current) {
    document.getElementById("step" + current).classList.remove("active");
    document.getElementById("step" + (current - 1)).classList.add("active");
    updateProgress(current - 1);
  }

  async function submitForm() {
    const name = document.getElementById("name").value.trim();
    const phone = document.getElementById("phone").value.trim();
    if (!name) { alert("Please enter your name."); return; }
    if (!phone) { alert("Please enter your phone number."); return; }
    formData.name = name;
    formData.phone = phone;

    // Submit to Web3Forms
    try {
      await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          access_key: "YOUR_WEB3FORMS_KEY",
          subject: "New Pool Remodel Quote Request. GK Swimming Pools",
          from_name: formData.name,
          message: `
Service: ${formData.service}
Pool Size: ${formData.poolSize}
Address: ${formData.address}
Name: ${formData.name}
Phone: ${formData.phone}
          `.trim()
        })
      });
    } catch(e) {
      console.error("Submission error", e);
    }

    // Show success + estimate
    document.getElementById("step4").classList.remove("active");
    document.getElementById("formProgress").style.display = "none";
    const range = (estimates[formData.service] || {})[formData.poolSize] || "$4,500 – $40,000";
    document.getElementById("estimateValue").textContent = range;
    document.getElementById("formSuccess").classList.add("active");
  }
</script>

</Layout>