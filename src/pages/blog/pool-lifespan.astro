  .blog-section strong { color:var(--color-deep); }
  .blog-section a { color:var(--color-deep); font-weight:700; text-decoration:underline; text-underline-offset:3px; }

  .lifespan-cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:var(--space-4); margin:var(--space-6) 0; }
  .lifespan-card { background:var(--color-white); border:1.5px solid var(--color-border); border-top:3px solid var(--color-aqua); border-radius:var(--radius-sm); padding:var(--space-6); }
  .lifespan-card__years { font-family:var(--font-heading); font-weight:800; font-size:var(--text-xl); color:var(--color-deep); margin-bottom:var(--space-2); }
  .lifespan-card__type { font-family:var(--font-heading); font-weight:700; font-size:var(--text-xs); text-transform:uppercase; letter-spacing:.08em; color:var(--color-muted); margin-bottom:var(--space-3); }
  .lifespan-card p { font-size:var(--text-sm); color:var(--color-muted); line-height:1.7; margin:0; }

