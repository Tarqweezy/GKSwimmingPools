// The card will appear automatically on this page.

const posts = [
  {
    title: "Swimming Pool Maintenance for Beginners",
    excerpt: "Learn the essential chemicals, tools, and routines every pool owner needs to keep their water clean, safe, and looking great year-round.",
    image: "/images/pool-maintenance-hero.webp",
    imageAlt: "Pool cleaning chemicals and tools on a wooden pool deck",
    slug: "/blog/swimming-pool-maintenance-beginners",
    category: "Pool Care",
    readTime: "7 min read",
    date: "July 13, 2025",
  },
  {
    title: "What Is the Average Cost to Resurface a Pool?",
    excerpt:
      "Most homeowners in the San Fernando Valley pay between $4,500 and $9,000 for a full resurface. Here's a breakdown by material and what actually moves the price up or down.",
    image: "/images/blog/pool-resurfacing-pebble-finish-santa-clarita.webp",
    imageAlt: "Pool being resurfaced with fresh plaster in Santa Clarita",
    slug: "/blog/pool-resurfacing-cost",
    category: "Pool Remodeling",
    readTime: "6 min read",
    date: "July 28, 2026",
  },
  // ADD NEW POSTS HERE. copy the block above and paste it below this line
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pool Care Blog | GK Swimming Pools</title>
  <meta name="description" content="Expert tips, guides, and advice on pool maintenance, cleaning, chemicals, and repairs from GK Swimming Pools. serving the San Fernando Valley and Santa Clarita." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://gkswimmingpools.com/blogs" />

  <!-- Open Graph -->
  <meta property="og:title" content="Pool Care Blog | GK Swimming Pools" />
  <meta property="og:description" content="Expert pool care tips and guides from GK Swimming Pools." />
  <meta property="og:type" content="website" />

  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Lato:wght@400;700&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --blue: #084184;
      --aqua: #5CE1E6;
      --white: #ffffff;
      --light-bg: #f0f8ff;
      --muted: #5a6a7a;
      --border: #dce8f5;
    }
    body { font-family: "Lato", sans-serif; background: var(--white); color: #1a1a2e; line-height: 1.7; }

    /* ── NAV ── */
    nav {
      background: var(--blue);
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    nav .logo {
      font-family: "Montserrat", sans-serif;
      font-weight: 800;
      color: var(--white);
      font-size: 1.2rem;
      letter-spacing: 0.05em;
      text-decoration: none;
    }
    nav .logo span { color: var(--aqua); }
    nav .nav-right { display: flex; align-items: center; gap: 2rem; }
    nav .nav-link {
      color: rgba(255,255,255,0.75);
      text-decoration: none;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      transition: color 0.2s;
    }
    nav .nav-link:hover { color: var(--aqua); }
    nav .nav-link.active { color: var(--aqua); }
    nav .nav-phone {
      color: var(--white);
      text-decoration: none;
      font-family: "Montserrat", sans-serif;
      font-weight: 700;
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      background: var(--aqua);
      color: var(--blue);
      padding: 0.45rem 1rem;
      border-radius: 3px;
      transition: opacity 0.2s;
    }
    nav .nav-phone:hover { opacity: 0.88; }

    /* ── PAGE HEADER ── */
    .page-header {
      background: linear-gradient(135deg, var(--blue) 0%, #0a5299 100%);
      padding: 4rem 2rem 3.5rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .page-header::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at top right, rgba(92,225,230,0.12) 0%, transparent 60%);
      pointer-events: none;
    }
    .page-header .eyebrow {
      font-family: "Montserrat", sans-serif;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--aqua);
      margin-bottom: 0.75rem;
    }
    .page-header h1 {
      font-family: "Montserrat", sans-serif;
      font-size: clamp(2rem, 5vw, 3.2rem);
      font-weight: 800;
      color: var(--white);
      line-height: 1.15;
      margin-bottom: 1rem;
    }
    .page-header p {
      color: rgba(255,255,255,0.75);
      font-size: 1rem;
      max-width: 520px;
      margin: 0 auto;
      line-height: 1.7;
    }
    .header-line {
      width: 48px;
      height: 3px;
      background: var(--aqua);
      margin: 1.5rem auto 0;
      border-radius: 2px;
    }

    /* ── MAIN LAYOUT ── */
    .blog-section {
      max-width: 1100px;
      margin: 0 auto;
      padding: 4rem 2rem 5rem;
    }

    .section-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .section-top h2 {
      font-family: "Montserrat", sans-serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--blue);
      letter-spacing: 0.03em;
    }
    .post-count {
      font-size: 0.82rem;
      color: var(--muted);
      font-weight: 600;
    }

    /* ── GRID ── */
    .posts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 2rem;
    }

    /* ── CARD ── */
    .post-card {
      background: var(--white);
      border: 1.5px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .post-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(8,65,132,0.12);
    }
    .card-img-wrap {
      position: relative;
      height: 210px;
      overflow: hidden;
    }
    .card-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }
    .post-card:hover .card-img-wrap img { transform: scale(1.04); }
    .card-category {
      position: absolute;
      top: 1rem;
      left: 1rem;
      font-family: "Montserrat", sans-serif;
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      background: var(--blue);
      color: var(--aqua);
      padding: 0.3rem 0.7rem;
      border-radius: 2px;
    }

    .card-body {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .card-meta {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.75rem;
    }
    .card-meta span {
      font-size: 0.78rem;
      color: var(--muted);
      font-weight: 600;
    }
    .card-meta .dot {
      width: 3px; height: 3px;
      border-radius: 50%;
      background: var(--muted);
    }
    .card-body h3 {
      font-family: "Montserrat", sans-serif;
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--blue);
      line-height: 1.3;
      margin-bottom: 0.75rem;
    }
    .card-body p {
      font-size: 0.9rem;
      color: #4a5568;
      line-height: 1.7;
      flex: 1;
      margin-bottom: 1.25rem;
    }
    .read-more {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-family: "Montserrat", sans-serif;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--blue);
      text-decoration: none;
      border-bottom: 2px solid var(--aqua);
      padding-bottom: 1px;
      transition: color 0.2s;
      width: fit-content;
    }
    .read-more:hover { color: #0a5299; }
    .read-more svg { transition: transform 0.2s; }
    .read-more:hover svg { transform: translateX(3px); }

    /* ── EMPTY STATE ── */
    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      color: var(--muted);
    }
    .empty-state p { font-size: 0.95rem; }

    /* ── CTA STRIP ── */
    .cta-strip {
      background: var(--light-bg);
      border-top: 3px solid var(--aqua);
      padding: 2.5rem 2rem;
      text-align: center;
    }
    .cta-strip p {
      font-size: 1rem;
      color: var(--blue);
      font-weight: 600;
      margin-bottom: 1rem;
    }
    .cta-btn {
      display: inline-block;
      background: var(--blue);
      color: var(--white);
      font-family: "Montserrat", sans-serif;
      font-weight: 800;
      font-size: 0.85rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.85rem 2rem;
      border-radius: 3px;
      text-decoration: none;
      transition: background 0.2s;
    }
    .cta-btn:hover { background: #0a5299; }

    /* ── FOOTER ── */
    footer {
      background: #05305f;
      color: rgba(255,255,255,0.5);
      text-align: center;
      padding: 1.5rem;
      font-size: 0.8rem;
    }
    footer strong { color: var(--aqua); }

    @media (max-width: 640px) {
      .nav-right .nav-link { display: none; }
      .page-header { padding: 3rem 1.5rem 2.5rem; }
      .blog-section { padding: 2.5rem 1.25rem 4rem; }
      .posts-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<!-- NAV -->
<nav>
  <a href="/" class="logo">GK <span>Swimming Pools</span></a>
  <div class="nav-right">
    <a href="/" class="nav-link">Home</a>
    <a href="/services" class="nav-link">Services</a>
    <a href="/blogs" class="nav-link active">Blog</a>
    <a href="tel:8188048204" class="nav-phone">(818) 804-8204</a>
  </div>
</nav>

<!-- PAGE HEADER -->
<div class="page-header">
  <div class="eyebrow">GK Swimming Pools</div>
  <h1>Pool Care Blog</h1>
  <p>Expert tips, guides, and advice to help you get the most out of your pool all year long.</p>
  <div class="header-line"></div>
</div>

<!-- BLOG GRID -->
<section class="blog-section">
  <div class="section-top">
    <h2>All Articles</h2>
    <span class="post-count">{posts.length} {posts.length === 1 ? "article" : "articles"}</span>
  </div>

  {posts.length > 0 ? (
    <div class="posts-grid">
      {posts.map((post) => (
        <article class="post-card">
          <a href={post.slug} class="card-img-wrap">
            <img
              src={post.image}
              alt={post.imageAlt}
              width="640"
              height="210"
              loading="lazy"
            />
            <div class="card-category">{post.category}</div>
          </a>
          <div class="card-body">
            <div class="card-meta">
              <span>{post.date}</span>
              <div class="dot"></div>
              <span>{post.readTime}</span>
            </div>
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
            <a href={post.slug} class="read-more">
              Read Article
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <p>No articles yet. Check back soon.</p>
    </div>
  )}
</section>

<!-- CTA STRIP -->
<div class="cta-strip">
  <p>Have a pool problem you can&rsquo;t solve? We&rsquo;re one call away.</p>
  <a href="tel:8188048204" class="cta-btn">Call (818) 804-8204</a>
</div>

<!-- FOOTER -->
<footer>
  &copy; 2025 <strong>GK Swimming Pools</strong>. Serving the San Fernando Valley &amp; Santa Clarita
</footer>

</body>
</html>
