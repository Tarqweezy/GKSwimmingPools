---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout
  title="Pool Retiling in Santa Clarita & Los Angeles | GK Swimming Pools"
  description="Pool retiling and waterline tile installation in Santa Clarita and the San Fernando Valley. Custom tile, mosaic, and full interior retile. Free estimates: (818) 804-8204."
>

  <section class="hero">
    <div class="hero__bg">
      <img src="/images/cities/pool-tile-detail.webp" alt="Custom pool tile work in Santa Clarita" fetchpriority="high" decoding="async" />
    </div>
    <div class="hero__overlay"></div>
    <div class="container hero__inner">
      <span class="hero__eyebrow">Pool Remodeling &middot; Santa Clarita</span>
      <h1>
        <span class="hero__h1-white">Pool Retiling</span>
        <span class="hero__h1-aqua">Santa Clarita &amp; Los Angeles</span>
      </h1>
      <p class="hero__sub">Update your waterline tile or resurface the full interior. Transform the look of your pool with custom tile work that lasts for decades.</p>
      <div class="hero__actions">
        <a href="/remodel-quote" class="btn btn--primary">Get a Free Estimate</a>
        <a href="tel:8188048204" class="btn btn--outline-white">Call (818) 804-8204</a>
      </div>
    </div>
  </section>

  <div class="trust-bar">
    <div class="trust-bar__inner">
      <span class="trust-item">20+ Years Experience</span>
      <span class="trust-item">3 Generations Family Owned</span>
      <span class="trust-item">Licensed &amp; Insured</span>
      <span class="trust-item">Financing Available</span>
      <span class="trust-item">5.0 &#9733; Google Rating</span>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Pool Tile Services</span>
        <h2>Custom Tile Work That Elevates Every Angle.</h2>
        <p>Pool tile is one of the most visible design elements of any backyard. Whether you're refreshing the waterline or doing a full interior retile, GK Swimming Pools handles the installation with precision.</p>
      </div>
      <div class="svc-cards">
        <div class="svc-card"><h3>Waterline Tile Replacement</h3><p>Fresh tile along the waterline instantly modernizes the look of any pool. Available in ceramic, glass, and porcelain in dozens of styles.</p></div>
        <div class="svc-card"><h3>Full Interior Retile</h3><p>For a complete transformation, we tile the entire pool interior. Pairs beautifully with a fresh replaster for a like-new finish throughout.</p></div>
        <div class="svc-card"><h3>Custom Mosaic &amp; Accents</h3><p>Decorative mosaic patterns, custom medallions, and accent pieces for pools that want a resort-style statement.</p></div>
        <div class="svc-card"><h3>Spa &amp; Step Tile</h3><p>We tile spa surrounds, steps, benches, and sun shelves. all matched to your main pool tile for a cohesive look.</p></div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Why GK</span>
        <h2>Why Choose GK Swimming Pools</h2>
      </div>
      <div class="why-grid">
        <div class="why-item"><div class="why-item__num">01</div><h3>Tile Selection Help</h3><p>Not sure what tile to pick? We guide you through options that work with your existing plaster, coping, and deck.</p></div>
        <div class="why-item"><div class="why-item__num">02</div><h3>Precise Installation</h3><p>Every tile is set level, grouted clean, and inspected before we fill the pool. No shortcuts, no callbacks.</p></div>
        <div class="why-item"><div class="why-item__num">03</div><h3>Bundle &amp; Save</h3><p>Retiling alongside a replaster or deck job saves money. We coordinate all trades so the project moves smoothly.</p></div>
        <div class="why-item"><div class="why-item__num">04</div><h3>Free On-Site Estimate</h3><p>We visit your pool, take measurements, and give you a detailed written quote. no guessing, no pressure.</p></div>
      </div>
    </div>
  </section>

  <div class="cta-band">
    <div class="container">
      <h2>Ready to Retile Your Pool?</h2>
      <p>Free on-site estimate. No obligation. Serving Santa Clarita and the San Fernando Valley.</p>
      <a href="/remodel-quote" class="btn btn--primary">Get My Free Estimate</a>
    </div>
  </div>

  <ContactForm />

</Layout>

<style>
  .hero { position:relative; min-height:500px; display:flex; align-items:center; justify-content:center; overflow:hidden; }
  .hero__bg { position:absolute; inset:0; }
  .hero__bg img { width:100%; height:100%; object-fit:cover; object-position:center; display:block; }
  .hero__overlay { position:absolute; inset:0; background:rgba(5,35,75,.58); }
  .hero__inner { position:relative; z-index:2; text-align:center; padding:var(--space-20) var(--space-8); width:100%; }
  .hero__eyebrow { font-family:var(--font-heading); font-size:var(--text-xs); font-weight:700; letter-spacing:.2em; text-transform:uppercase; color:var(--color-aqua); display:block; margin-bottom:var(--space-6); }
  .hero__h1-white { font-family:var(--font-heading); font-weight:800; text-transform:uppercase; letter-spacing:.02em; line-height:1.05; color:var(--color-white); font-size:clamp(2rem,5vw,3.8rem); display:block; }
  .hero__h1-aqua { font-family:var(--font-heading); font-weight:800; text-transform:uppercase; letter-spacing:.02em; line-height:1.05; color:var(--color-aqua); font-size:clamp(2rem,5vw,3.8rem); display:block; margin-bottom:var(--space-8); }
  .hero__sub { color:rgba(255,255,255,.82); font-size:var(--text-lg); max-width:560px; margin:0 auto var(--space-10); line-height:1.75; }
  .hero__actions { display:flex; gap:var(--space-4); flex-wrap:wrap; justify-content:center; }
  .btn--outline-white { display:inline-block; border:2px solid rgba(255,255,255,.7); color:var(--color-white); font-family:var(--font-heading); font-weight:700; font-size:var(--text-sm); letter-spacing:.06em; text-transform:uppercase; padding:var(--space-4) var(--space-8); border-radius:var(--radius-sm); text-decoration:none; }
  .trust-bar { background:#05305f; padding:var(--space-4) var(--space-8); }
  .trust-bar__inner { max-width:1060px; margin:0 auto; display:flex; align-items:center; justify-content:center; gap:var(--space-8); flex-wrap:wrap; }
  .trust-item { color:rgba(255,255,255,.82); font-size:var(--text-xs); font-weight:700; letter-spacing:.05em; text-transform:uppercase; white-space:nowrap; }
  .svc-cards { display:grid; grid-template-columns:repeat(4,1fr); gap:var(--space-5); }
  .svc-card { background:var(--color-white); border:1.5px solid var(--color-border); border-top:3px solid var(--color-aqua); border-radius:var(--radius-sm); padding:var(--space-6); }
  .svc-card h3 { font-family:var(--font-heading); font-weight:700; font-size:var(--text-sm); color:var(--color-deep); text-transform:uppercase; letter-spacing:.04em; margin-bottom:var(--space-3); }
  .svc-card p { font-size:var(--text-sm); color:var(--color-muted); line-height:1.7; }
  .why-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:var(--space-8); }
  .why-item { padding:var(--space-6); border-left:3px solid var(--color-aqua); }
  .why-item__num { font-family:var(--font-heading); font-weight:800; font-size:1.8rem; color:var(--color-aqua); line-height:1; margin-bottom:var(--space-3); }
  .why-item h3 { font-family:var(--font-heading); font-weight:700; font-size:var(--text-sm); color:#ffffff; text-transform:uppercase; letter-spacing:.03em; margin-bottom:var(--space-2); }
  .why-item p { font-size:var(--text-sm); color:rgba(255,255,255,.82); line-height:1.7; }
  @media(max-width:900px) {
    .svc-cards { grid-template-columns:repeat(2,1fr); }
    .why-grid { grid-template-columns:repeat(2,1fr); }
  }
  @media(max-width:600px) {
    .svc-cards { grid-template-columns:1fr; }
    .hero__actions { flex-direction:column; align-items:center; }
  }
</style>
