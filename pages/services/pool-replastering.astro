---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import FAQSection from '../../components/FAQSection.astro';
import { poolReplasteringFAQs } from '../../data/faq-data.js';
---

<Layout
  title="Pool Replastering in Santa Clarita & Los Angeles | GK Swimming Pools"
  description="Expert pool replastering in Santa Clarita and the San Fernando Valley. Standard plaster, pebble tec, and quartz finishes. Free on-site estimates: (818) 804-8204."
>

  <section class="hero">
    <div class="hero__bg">
      <img src="/images/services/pool-remodeling-hero.webp" alt="Freshly replastered pool in Santa Clarita" fetchpriority="high" decoding="async" />
    </div>
    <div class="hero__overlay"></div>
    <div class="container hero__inner">
      <span class="hero__eyebrow">Pool Remodeling &middot; Santa Clarita</span>
      <h1>
        <span class="hero__h1-white">Pool Replastering</span>
        <span class="hero__h1-aqua">Santa Clarita &amp; Los Angeles</span>
      </h1>
      <p class="hero__sub">Restore your pool's surface to like-new condition. Smooth, clean, and durable. from standard plaster to premium pebble finishes.</p>
      <div class="hero__actions">
        <a href="/remodel-quote" class="btn btn--primary">Get a Free Estimate</a>
        <a href="tel:8188048204" class="btn btn--outline-white">Call (818) 804-8204</a>
      </div>
    </div>
  </section>

  <div class="trust-bar">
    <div class="trust-bar__inner">
      <span class="trust-item">20+ Years Experience</span>
      <span class="trust-sep" aria-hidden="true">|</span>
      <span class="trust-item">3 Generations Family Owned</span>
      <span class="trust-sep" aria-hidden="true">|</span>
      <span class="trust-item">Licensed &amp; Insured</span>
      <span class="trust-sep" aria-hidden="true">|</span>
      <span class="trust-item">Financing Available</span>
      <span class="trust-sep" aria-hidden="true">|</span>
      <span class="trust-item">5.0 &#9733; Google Rating</span>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">What Is Pool Replastering</span>
        <h2>A Fresh Surface. A Brand New Pool.</h2>
        <p>Pool replastering removes old, worn plaster and applies a fresh coat to the interior. restoring water clarity, fixing rough surfaces, and stopping slow leaks caused by deteriorating plaster.</p>
      </div>
      <div class="finish-cards">
        <div class="finish-card">
          <div class="finish-card__price">From $4,500</div>
          <h3>Standard White Plaster</h3>
          <p>The most affordable option. Smooth, clean finish. Lasts 7–10 years with proper chemical maintenance.</p>
        </div>
        <div class="finish-card">
          <div class="finish-card__price">From $6,000</div>
          <h3>Quartz Aggregate</h3>
          <p>Mid-range option with added durability and texture. More resistant to staining and chemical wear.</p>
        </div>
        <div class="finish-card finish-card--featured">
          <div class="finish-card__badge">Most Popular</div>
          <div class="finish-card__price">From $8,000</div>
          <h3>Pebble Tec Finish</h3>
          <p>Premium option lasting 15–20+ years. Textured, resort-quality look in dozens of color combinations.</p>
        </div>
        <div class="finish-card">
          <div class="finish-card__price">From $7,500</div>
          <h3>Exposed Aggregate</h3>
          <p>Bold texture with natural stone materials. Highly durable and visually striking for modern backyards.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Know the Signs</span>
        <h2>Does Your Pool Need Replastering?</h2>
      </div>
      <div class="signs-grid">
        <div class="sign-item"><h3>Rough Texture</h3><p>If the walls and floor feel like sandpaper underfoot, your plaster has worn down and is past its prime.</p></div>
        <div class="sign-item"><h3>Stubborn Staining</h3><p>Stains that won't clear with chemical treatment or acid washing are a sign the plaster is too far gone to restore.</p></div>
        <div class="sign-item"><h3>Chalky Residue</h3><p>White chalky deposits on your skin after swimming indicate the plaster is leaching calcium into the water.</p></div>
        <div class="sign-item"><h3>Cracks or Chipping</h3><p>Visible cracks around steps, walls, or the floor can allow water to escape and worsen quickly if ignored.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Why GK</span>
        <h2>Why Choose GK Swimming Pools</h2>
      </div>
      <div class="why-grid">
        <div class="why-item"><div class="why-item__num">01</div><h3>Free Assessment</h3><p>We inspect your plaster in person and give you an honest recommendation. replaster, acid wash, or repair.</p></div>
        <div class="why-item"><div class="why-item__num">02</div><h3>All Finishes Available</h3><p>We work with standard plaster, quartz, pebble, and aggregate. You pick the look, we handle the installation.</p></div>
        <div class="why-item"><div class="why-item__num">03</div><h3>Full Startup Included</h3><p>After the pool is refilled, we handle the chemical startup process from day one so you don't have to.</p></div>
        <div class="why-item"><div class="why-item__num">04</div><h3>Financing Available</h3><p>Third-party financing available so budget doesn't hold you back from the finish you really want.</p></div>
      </div>
    </div>
  </section>

  <FAQSection faqs={poolReplasteringFAQs} heading="Pool Replastering FAQs" />

  <div class="cta-band">
    <div class="container">
      <h2>Ready to Replaster Your Pool?</h2>
      <p>Free on-site assessment. No obligation. Serving Santa Clarita and the San Fernando Valley.</p>
      <a href="/remodel-quote" class="btn btn--primary">Get My Free Estimate</a>
    </div>
  </div>

  <ContactForm />

</Layout>

<style>
  .hero { position:relative; min-height:500px; display:flex; align-items:center; justify-content:center; overflow:hidden; }
  .hero__bg { position:absolute; inset:0; }
  .hero__bg img { width:100%; height:100%; object-fit:cover; object-position:center; display:block; }
  .hero__overlay { position:absolute; inset:0; background:rgba(5,35,75,.58); }
  .hero__inner { position:relative; z-index:2; text-align:center; padding:var(--space-20) var(--space-8); width:100%; }
  .hero__eyebrow { font-family:var(--font-heading); font-size:var(--text-xs); font-weight:700; letter-spacing:.2em; text-transform:uppercase; color:var(--color-aqua); display:block; margin-bottom:var(--space-6); }
  .hero__h1-white { font-family:var(--font-heading); font-weight:800; text-transform:uppercase; letter-spacing:.02em; line-height:1.05; color:var(--color-white); font-size:clamp(2rem,5vw,3.8rem); display:block; }
  .hero__h1-aqua { font-family:var(--font-heading); font-weight:800; text-transform:uppercase; letter-spacing:.02em; line-height:1.05; color:var(--color-aqua); font-size:clamp(2rem,5vw,3.8rem); display:block; margin-bottom:var(--space-8); }
  .hero__sub { color:rgba(255,255,255,.82); font-size:var(--text-lg); max-width:560px; margin:0 auto var(--space-10); line-height:1.75; }
  .hero__actions { display:flex; gap:var(--space-4); flex-wrap:wrap; justify-content:center; }
  .btn--outline-white { display:inline-block; border:2px solid rgba(255,255,255,.7); color:var(--color-white); font-family:var(--font-heading); font-weight:700; font-size:var(--text-sm); letter-spacing:.06em; text-transform:uppercase; padding:var(--space-4) var(--space-8); border-radius:var(--radius-sm); text-decoration:none; }
  .trust-bar { background:#05305f; padding:var(--space-4) var(--space-8); }
  .trust-bar__inner { max-width:1060px; margin:0 auto; display:flex; align-items:center; justify-content:center; gap:var(--space-4); flex-wrap:wrap; }
  .trust-sep { color:rgba(255,255,255,.3); font-size:.85rem; user-select:none; }
  .trust-item { color:rgba(255,255,255,.82); font-size:var(--text-xs); font-weight:700; letter-spacing:.05em; text-transform:uppercase; white-space:nowrap; }
  .finish-cards { display:grid; grid-template-columns:repeat(4,1fr); gap:var(--space-4); }
  .finish-card { background:var(--color-white); border:1.5px solid var(--color-border); border-top:3px solid var(--color-border); border-radius:var(--radius-sm); padding:var(--space-6); position:relative; }
  .finish-card--featured { border-top-color:var(--color-aqua); }
  .finish-card__badge { position:absolute; top:-1px; right:var(--space-4); background:var(--color-aqua); color:var(--color-deep); font-family:var(--font-heading); font-size:.6rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; padding:.2rem .6rem; border-radius:0 0 3px 3px; }
  .finish-card__price { font-family:var(--font-heading); font-weight:800; font-size:var(--text-xl); color:var(--color-deep); margin-bottom:var(--space-2); }
  .finish-card h3 { font-family:var(--font-heading); font-weight:700; font-size:var(--text-sm); color:var(--color-deep); text-transform:uppercase; letter-spacing:.04em; margin-bottom:var(--space-3); }
  .finish-card p { font-size:var(--text-sm); color:var(--color-muted); line-height:1.7; }
  .signs-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:var(--space-6); }
  .sign-item { padding:var(--space-6); border-left:3px solid var(--color-aqua); }
  .sign-item h3 { font-family:var(--font-heading); font-weight:700; font-size:var(--text-sm); color:var(--color-deep); text-transform:uppercase; letter-spacing:.03em; margin-bottom:var(--space-3); }
  .sign-item p { font-size:var(--text-sm); color:var(--color-muted); line-height:1.7; }
  .why-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:var(--space-8); }
  .why-item { padding:var(--space-6); border-left:3px solid var(--color-aqua); }
  .why-item__num { font-family:var(--font-heading); font-weight:800; font-size:1.8rem; color:var(--color-aqua); line-height:1; margin-bottom:var(--space-3); }
  .why-item h3 { font-family:var(--font-heading); font-weight:700; font-size:var(--text-sm); color:#ffffff; text-transform:uppercase; letter-spacing:.03em; margin-bottom:var(--space-2); }
  .why-item p { font-size:var(--text-sm); color:rgba(255,255,255,.82); line-height:1.7; }
  @media(max-width:900px) {
    .finish-cards { grid-template-columns:repeat(2,1fr); }
    .signs-grid { grid-template-columns:repeat(2,1fr); }
    .why-grid { grid-template-columns:repeat(2,1fr); }
  }
  @media(max-width:600px) {
    .finish-cards { grid-template-columns:1fr; }
    .signs-grid { grid-template-columns:1fr; }
    .why-grid { grid-template-columns:1fr 1fr; }
    .hero__actions { flex-direction:column; align-items:center; }
  }
</style>
